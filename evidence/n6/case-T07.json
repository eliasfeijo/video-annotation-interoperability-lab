          }
        ]
      },
      {
        "malformed": [
          {
            "dimension": "xywh",
            "value": "1,2,3",
            "reason": "expected 4 comma-separated components, got 3"
          }
        ]
      },
      {
        "malformed": [
          {
            "dimension": "t",
            "value": ",,",
            "reason": "expected at most 2 components, got 3"
          }
        ]
      }
    ],
    "conforming": [
      false,
      false,
      false
    ]
  }
